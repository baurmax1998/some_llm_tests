goal page = {
    output: "index.html",
    title: "SIC Todos",
    html: """
<main>
  <p class="eyebrow">SIC · FastAPI</p>
  <h1>Was steht an?</h1>
  <form data-sic-submit="createTodo">
    <input name="title" aria-label="Neues Todo" placeholder="Neues Todo …" required>
    <button type="submit">Hinzufügen</button>
  </form>
  <ul id="todos" aria-live="polite"></ul>
  <pre data-sic-output="createTodo"></pre>
</main>
""",
    css: """
:root {{ color-scheme: dark; font-family: Inter, system-ui, sans-serif; background: #0b1020; color: #eef2ff; }}
body {{ margin: 0; min-height: 100vh; display: grid; place-items: center; }}
main {{ width: min(42rem, calc(100% - 2rem)); background: #151c33; padding: 2rem; border-radius: 1.25rem; box-shadow: 0 1.5rem 5rem #0008; }}
.eyebrow {{ color: #8ea2ff; letter-spacing: .16em; text-transform: uppercase; }}
h1 {{ margin-top: 0; font-size: clamp(2rem, 8vw, 4rem); }}
form, li {{ display: flex; gap: .75rem; }}
input {{ flex: 1; }} input, button {{ padding: .85rem 1rem; border: 0; border-radius: .7rem; font: inherit; }}
button {{ cursor: pointer; background: #8ea2ff; color: #0b1020; font-weight: 700; }}
ul {{ padding: 0; display: grid; gap: .65rem; }}
li {{ align-items: center; padding: .8rem; background: #0b1020; border-radius: .7rem; }}
li span {{ flex: 1; }} li.done span {{ text-decoration: line-through; opacity: .55; }}
pre:empty {{ display: none; }} pre {{ color: #ff9b9b; white-space: pre-wrap; }}
""",
    js: """
const list = document.querySelector("#todos");
async function refresh() {{
  const todos = await sic.call("listTodos");
  list.replaceChildren(...todos.map(todo => {{
    const item = document.createElement("li");
    if (todo.completed) item.className = "done";
    const label = document.createElement("span");
    label.textContent = todo.title;
    const toggle = document.createElement("button");
    toggle.textContent = todo.completed ? "Zurück" : "Fertig";
    toggle.onclick = async () => {{ await sic.call("toggleTodo", {{id: todo.id}}); await refresh(); }};
    const remove = document.createElement("button");
    remove.textContent = "Löschen";
    remove.onclick = async () => {{ await sic.call("deleteTodo", {{id: todo.id}}); await refresh(); }};
    item.append(label, toggle, remove);
    return item;
  }}));
}}
document.addEventListener("sic:result", event => {{ if (event.detail.name === "createTodo") refresh(); }});
refresh();
"""
}
